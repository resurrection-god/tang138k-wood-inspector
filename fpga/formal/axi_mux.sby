# axi_mux: the N:1 AXI4 interconnect in front of the DDR3 IP (fpga/src/axi_mux.v).
# Run from fpga/formal:  .\run.ps1 axi_mux [task ...]
#
#   bmc     2 write + 2 read masters, 8-bit data, bursts of 1..4 beats, W-order
#           FIFO 4 AWs, read FIFO 4 beats per port; any ready/valid pattern
#   live    the same with an always-ready slave and masters: no AW / AR waits
#           12 cycles or more
#   cover   reachability of the cases the properties are about
[tasks]
prove
bmc
live
cover

[options]
prove: mode prove
prove: depth 2
bmc:   mode bmc
bmc:   depth 20
live:  mode bmc
live:  depth 20
cover: mode cover
cover: depth 30

[engines]
smtbmc bitwuzla

[script]
prove: read_slang --top axi_mux_fv axi_mux.v axi_mux_fv.sv
bmc:   read_slang --top axi_mux_fv axi_mux.v axi_mux_fv.sv
live:  read_slang --top axi_mux_fv -G LIVE=1 axi_mux.v axi_mux_fv.sv
cover: read_slang --top axi_mux_fv axi_mux.v axi_mux_fv.sv
prep -top axi_mux_fv
# flops without a reset start at 0 (data registers and FIFO memories only;
# their contents are read only after a write)
memory_map
setundef -zero -init
setundef -zero
opt -fast

[files]
../src/axi_mux.v
axi_mux_fv.sv
