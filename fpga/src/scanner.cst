
//TANG_MEGA-138K_Pro_Dock
//GW5AST-LV138FPGA676AES
//GW5AST-138
//B

IO_LOC "CLK"    P16;        //EMC_CLK
IO_LOC "RSTN"   G16;        //S3
IO_PORT "RSTN"  IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

//LED
IO_LOC "LED[0]" J14;        //LED1
IO_LOC "LED[1]" R26;        //LED2
IO_LOC "LED[2]" L20;
IO_LOC "LED[3]" M25;
IO_LOC "LED[4]" N21;

// Onboard User LEDs (0-5), active low

IO_PORT "LED[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "LED[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "LED[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "LED[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "LED[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

//UART2
IO_LOC "UART2_TXD" W20;     //35
IO_LOC "UART2_RXD" Y20;     //36

//JTAG
IO_LOC "TMS_IN"     W21;    //5  p4
IO_LOC "TCK_IN"     Y21;    //6  p6
IO_LOC "TRST_IN"    P21;    //7  p10
IO_LOC "TDO_OUT"    U17;    //8  p11
IO_LOC "TDI_IN"     P23;    //9  p12

//Ethernet : RGMII
IO_LOC "PHY_CLK" 		E18;
IO_LOC "PHY_RST_N"  	E17;
IO_LOC "RGMII_TXC"      H24;
IO_LOC "RGMII_TX_CTL"   J24;
IO_LOC "RGMII_TXD[0]"   K21;
IO_LOC "RGMII_TXD[1]"   J21;
IO_LOC "RGMII_TXD[2]"   L19;
IO_LOC "RGMII_TXD[3]"   K18;
IO_LOC "RGMII_RXC"      C23;
CLOCK_LOC "RGMII_RXC_d"    BUFG = CLK;
CLOCK_LOC "AHB_CLK"        BUFG = CLK;
CLOCK_LOC "DDR3_CLK_IN"    BUFG = CLK;
CLOCK_LOC "GTX_CLK"        BUFG = CLK;
CLOCK_LOC "clk_x1"         BUFG = CLK;
IO_LOC "RGMII_RX_CTL"   C22;
IO_LOC "RGMII_RXD[0]"   B26;
IO_LOC "RGMII_RXD[1]"   C26;
IO_LOC "RGMII_RXD[2]"   D26;
IO_LOC "RGMII_RXD[3]"   E26;
IO_LOC "MDC"            K23;
IO_LOC "MDIO"           K22;

//SPI-Flash Memory
IO_LOC "FLASH_SPI_CSN"    P18;
IO_LOC "FLASH_SPI_CLK"    H13;
IO_LOC "FLASH_SPI_MOSI"   R14;    //DO[0] DI
IO_LOC "FLASH_SPI_MISO"   R15;    //DO[1] DO
IO_LOC "FLASH_SPI_WPN"    P14;    //DO[2]
IO_LOC "FLASH_SPI_HOLDN"  N14;    //DO[3]

//DDR3 Memory
IO_LOC "DDR3_INIT"     N23;	      //LED5
// Pins the controller does not use but which must have a defined level
// (ERRORS 1.4; 1.10 refines the cause). U5 is A14 of both chips: undeclared, it
// floated, the address lines next to it on the BGA (T4/T3/U1/U2/T2) coupled a pulse
// onto it when crossing a 512 KB boundary, the chip latched a false one on A14 and
// opened a foreign row - writes went past the array. E3/A3 are the write masks of
// the second chip, they floated too.
IO_LOC "I2C_SCL"       K25;
IO_LOC "I2C_SDA"       K26;
IO_LOC "TWI_MUX_S0"    P26;
IO_LOC "TWI_MUX_S1"    P19;
IO_LOC "TWI_MUX_S2"    N19;

IO_PORT "I2C_SCL"        IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "I2C_SDA"        IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "TWI_MUX_S0"     IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "TWI_MUX_S1"     IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "TWI_MUX_S2"     IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "DDR3_INIT"      PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
INS_LOC "u_Gowin_PLL/PLL_inst" PLL_L[0]

INS_LOC "u_Gowin_PLL_AE350/PLL_inst" PLL_R[0]

// Write protection of EEPROM U24 (ZD24C08A): net EEPROM_WP, pin 38 of the SOM
// connector, ball V14 (Dock schematic, sheet 5). PULL_MODE=UP - by default writing
// is DISABLED, including while the GPIO is an input after reset. The firmware pulls
// it low, and only for the duration of a write.
IO_LOC  "EEPROM_WP"    V14;
IO_PORT "EEPROM_WP"    IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// ---- AXI4 back end (AXI4 migration stage 3, ERRORS 1.20; docs/ARCHITECTURE.md § 4.1):
// DDR3 x32 with A14 on U5, from fpga/axi_probe/axi_probe.cst (ran on the board
// 08.10.2026). The old x16 lines and the placement of the SoC's own DDR3 PHY are
// removed above.
